# Copy to .env and fill in. Never commit the real .env.

# Backend (Lovable Cloud / Supabase) — publishable values, safe in the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Same values for server-side rendering
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets — set in Project Settings > Secrets, never in the client
ANTHROPIC_API_KEY=
